{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist/main",
    "rootDir": "./src/main",
    "baseUrl": ".",
    "paths": {
      "@pos/shared": [
        "../../packages/shared/dist/index"
      ]
    },
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src/main"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/preload"
  ]
}